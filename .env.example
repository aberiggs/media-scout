# media-agent configuration — fill me in and save as .env (gitignored).

# ── Service endpoints + API keys (all required) ──
# API keys: in each app's UI → Settings → General → Security → API Key.
# Prowlarr: http://<host>:9696
PROWLARR_URL=
PROWLARR_API_KEY=
# Sonarr: http://<host>:8989 (serves /api/v3)
SONARR_URL=
SONARR_API_KEY=
# Radarr: http://<host>:7878 (serves /api/v3)
RADARR_URL=
RADARR_API_KEY=

# ── Prowlarr download-client routing (required) ──
# Create TWO download-client entries in Prowlarr → Settings → Download Clients,
# both pointing at your qBittorrent, e.g.:
#   qBit-TV     → category "tv-sonarr"  (must equal Sonarr's client category)
#   qBit-Movies → category "radarr"     (must equal Radarr's client category)
# *arr Completed Download Handling only imports grabs that carry its category.
# Entry names are free-form — put the EXACT names here; the agent resolves
# them via GET /api/v1/downloadclient at runtime, so renaming later only
# means editing this file.
PROWLARR_CLIENT_TV=
PROWLARR_CLIENT_MOVIE=

# ── LLM (OpenAI-compatible; defaults to OpenRouter) ──
# OpenRouter keys: https://openrouter.ai/keys
# Point LLM_BASE_URL at any OpenAI-compatible server (e.g. a local one) to swap.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash
# Optional plain-language soft ranking guidance; does not filter candidates.
# Example: MEDIA_PREFERENCES=Prefer 1080p over 4K.
MEDIA_PREFERENCES=

# ── Runtime ──
# Daemon loop interval (minutes) and per-work-unit retry window (hours):
# reconciliation runs on this cadence; paid search/planning is due-time gated,
# and skip/dry-run decisions use the longer per-work-unit retry window.
# Successful searches with no admitted candidates enter a manual hold.
CYCLE_INTERVAL_MIN=5
MIN_RETRY_HOURS=6
# Failure backoff uses min(base * 2^(failCount-1), cap); a longer server Retry-After wins.
FAILURE_BACKOFF_MIN=5
FAILURE_BACKOFF_MAX_MIN=60
# Grace period for a successful grab to appear in the *arr queue. Expiry/unknown
# queue state is held for review rather than automatically resubmitted.
QUEUE_GRACE_MIN=30
# true = full cycle runs, grabs are logged but NOT executed. Flip to false
# only after reviewing live candidates and routing; it does not block searches or LLM calls.
DRY_RUN=true
# Explicitly opt in to the isolated operator recovery lane. This is not identity proof;
# MCP hosts must require human approval for ma_review_action before exposing it.
ALLOW_OPERATOR_ACTIONS=false
DB_PATH=data/media-agent.db
HTTP_PORT=7877
LOG_LEVEL=info

# Published-image Compose only (docker-compose.ghcr.yml). Set after the image is published.
# Leave unset for source build. The Compose service remains named "media-agent".
# MEDIA_AGENT_IMAGE=ghcr.io/aberiggs/media-scout:dev
